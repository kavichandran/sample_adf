{
	"name": "13_PL_Exportcatageoryfiles",
	"properties": {
		"activities": [
			{
				"name": "fetch all distint values",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "select distinct Category\nfrom [dbo].[products]"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "looping_the catgeory",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "fetch all distint values",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('fetch all distint values').output.resultsets[0].rows",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "assigning singleCatgeory",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "singleCategory",
								"value": {
									"value": "@item().Category",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Copy category files",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "assigning singleCatgeory",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('select * from [dbo].[products] \nwhere category = ','''',variables('singleCategory'),'''')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_sqldbadea06_productwithfilter",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_destdiffcategoryfilescsv",
									"type": "DatasetReference",
									"parameters": {
										"Filename": {
											"value": "@concat(variables('singleCategory'),'.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"singleCategory": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-23T01:25:03Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}