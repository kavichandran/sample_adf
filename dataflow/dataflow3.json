{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "EmployeeDS_txt",
						"type": "DatasetReference"
					},
					"name": "Json"
				},
				{
					"dataset": {
						"referenceName": "deptcsv_DS",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "assert1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmployeeID as short,",
				"          First_name as string,",
				"          Last_Name as string,",
				"          MailId as string,",
				"          Contact as string,",
				"          DOJ as date,",
				"          Jobid as short,",
				"          Salary as short,",
				"          MGRID as string,",
				"          DeptID as short,",
				"          Fullname as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Json",
				"source(output(",
				"          Deptid as integer,",
				"          Name as string,",
				"          Location as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"Json, source1 assert(expectTrue(instr(MailId, \"@\")>1, false, 'checkEmployeeID'),",
				"     expectUnique(EmployeeID, false, 'emplyeeunique'),",
				"     expectExists(Json@DeptID == source1@Deptid, false, 'integrety')) ~> assert1",
				"assert1 derive(Error = isError()) ~> derivedColumn1",
				"derivedColumn1 filter(Error==false()) ~> filter1"
			]
		}
	}
}